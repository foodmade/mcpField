# 与 mcp-field 共用的 MySQL 数据库
DATABASE_URL=mysql://root:<password>@127.0.0.1:3306/mcp_field

# 抓取时的 User-Agent：写明爬虫名称和可以联系到你的地址
CRAWLER_USER_AGENT="MCPFieldBot/0.1 (+https://mcpfield.dev/bot)"

# 原始 HTML 存档目录、本地调试输出目录
DATA_DIR=./data

# 抓取 GitHub README、仓库统计用的 token（每小时 5000 次；不设置只有 60 次）。只需要读取公开仓库的权限
GITHUB_TOKEN=

# trace | debug | info | warn | error
LOG_LEVEL=info

# 后端 API
API_PORT=3100
# 监听地址，默认只接受本机请求
API_HOST=127.0.0.1
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5288

# 翻译 / 内容生成用的 Claude 接口（可指向兼容 Anthropic Messages API 的代理）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-5-5
# AI 介绍、README 翻译默认全部用 Haiku；如需给星数 ≥ 1000 的热门项目单独用其他模型，设置下面两项
# OVERVIEW_PREMIUM_MODEL=
# README_PREMIUM_MODEL=
# README 翻译的后备模型：主模型被限流（429）时暂停（1 分钟起，仍被限流就加倍，最长 15 分钟），期间改用它，可以是另一个模型服务
# README_FALLBACK_PROVIDER=openai
# README_FALLBACK_MODEL=gpt-6-luna

# Cloudflare R2：图标等静态资源。R2_PUBLIC_BASE_URL 正式环境请换成绑定的自定义域名
R2_ACCOUNT_ID=
R2_BUCKET=mcp-field-assets
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 翻译（简介、README）用哪个模型服务：claude（默认）、openai（OpenAI 兼容接口，如 ChatGPT 模型）、minimax、opencode 或 qwen
TRANSLATE_PROVIDER=claude
OPENAI_BASE_URL=
OPENAI_API_KEY=
# MiniMax（国内站密钥配 api.minimaxi.com，国际站配 api.minimax.io）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# OpenCode Go 订阅（模型如 mimo-v2.6-flash、deepseek-v4.1-flash）；DeepSeek 等模型要求在控制台工作区的 Privacy 设置里选 Global 区域。
# Go 按模型分别计额度：每 5 小时最多用掉月额度的 20%，每周 50%。claude- 开头的模型（如 claude-haiku-5-5）自动走 Messages 接口，
# 可以和其他模型搭配：例如 README_MODEL=mimo-v2.6-flash，README_PREMIUM_MODEL=claude-haiku-5-5（热门项目用 Haiku）
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/v1
# 阿里云百炼（模型如 qwen3.7-flash）；业务空间有专属地址时换成它。Qwen3 默认开思考，翻译要配 TRANSLATE_REASONING_EFFORT=none
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 翻译时推理模型的推理强度（none / minimal / low / medium / high），不设置用模型默认值。
# 翻译不需要推理：deepseek-v4.1-flash 设为 none 后，长片段从约 99 秒（8000+ 推理 token）降到 8 秒；MiniMax M3 不允许 none
# TRANSLATE_REASONING_EFFORT=none
# AI 介绍用哪个模型服务，取值同上；用 openai 时把 OVERVIEW_MODEL 也换掉
# OVERVIEW_PROVIDER=claude
# 分类器用哪个模型服务，取值同上；用 openai 时把 CLASSIFY_MODEL 也换掉
# CLASSIFY_PROVIDER=claude
# 自撰内容（Loop / CLI / Agent）用哪个模型服务，取值同上；用 openai 时把 DESCRIBE_MODEL、DESCRIBE_LOOP_MODEL 也换掉
# DESCRIBE_PROVIDER=claude
# 翻译的默认并发数：不设置时简介 4、README 6（适合 Claude 网关）；代理并发上限高时调大
# TRANSLATE_CONCURRENCY=72
# 用 openai 时把模型也换掉，例如 gpt-6-luna
# TRANSLATE_MODEL=claude-haiku-5-5
# README_MODEL=claude-haiku-5-5
