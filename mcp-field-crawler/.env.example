# 与 mcp-field 共用的 MySQL 数据库
DATABASE_URL=mysql://root:<password>@127.0.0.1:3306/mcp_field

# 抓取时的 User-Agent：写明爬虫名称和可以联系到你的地址
CRAWLER_USER_AGENT="MCPFieldBot/0.1 (+https://mcpfield.dev/bot)"

# 原始 HTML 存档目录、本地调试输出目录
DATA_DIR=./data

# 可选：GitHub 补全用的 token（提高 API 额度）
GITHUB_TOKEN=

# trace | debug | info | warn | error
LOG_LEVEL=info

# 后端 API
API_PORT=3100
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5288

# 翻译 / 内容生成用的 Claude 接口（可指向兼容 Anthropic Messages API 的代理）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-4-5-20251001

# Cloudflare R2：图标等静态资源。R2_PUBLIC_BASE_URL 正式环境请换成绑定的自定义域名
R2_ACCOUNT_ID=
R2_BUCKET=mcp-field-assets
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
