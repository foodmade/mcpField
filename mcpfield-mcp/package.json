  "description": "MCP server for MCP Field: search MCP servers and Skills, manage your saved items, install Skills and generate MCP configs from Claude Code, Codex, Gemini CLI and other agents.",
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "agent-skills", "claude-code", "codex", "gemini-cli", "mcpfield"],
  "homepage": "https://mcpfield.com/console/keys",
